{% extends "TrendixAdminBundle::layout.html.twig" %}

{% block body_class %}login-content {{ admin_theme|default("blue") }}{% endblock %}

{% block body %}
<div class="login-content">
    <!-- Login -->
    <div class="lc-block toggled" id="l-login">

        <form action="{{ path("admin_check") }}" method="post" name="loginform">
            {% if loginTitle is defined and loginTitle %}
                <h1>{{ loginTitle }}</h1>
            {% endif %}
            {% if error %}
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
            <div class="input-group m-b-20">
                <span class="input-group-addon"><i class="zmdi zmdi-account"></i></span>
                <div class="fg-line">
                    <input type="text" class="form-control" id="username" name="_username" value="{{ last_username }}"
                           required="required" placeholder="{{ 'security.login.username'|trans }}">
                </div>
            </div>

            <div class="input-group m-b-20">
                <span class="input-group-addon"><i class="zmdi zmdi-male"></i></span>
                <div class="fg-line">
                    <input type="password" class="form-control" id="password" name="_password" required="required"
                           placeholder="{{ 'security.login.password'|trans }}">
                </div>
            </div>

            <div class="clearfix"></div>

            <div class="checkbox">
                <label>
                    <input type="checkbox" id="remember_me" name="_remember_me" value="on">
                    <i class="input-helper"></i>
                    {{ 'security.login.remember_me'|trans }}
                </label>
            </div>

            <button type="submit" class="btn btn-login btn-danger btn-float waves-effect waves-circle waves-float"
                    id="_submit" name="_submit">
                <i class="zmdi zmdi-arrow-forward"></i>
            </button>
            {#
            <ul class="login-navigation">
                <li data-block="#l-register" class="bgm-red">Register</li>
                <li data-block="#l-forget-password" class="bgm-orange">Forgot Password?</li>
            </ul>#}
            <ul class="login-navigation">
                <li data-block="#l-forget-password" class="bgm-orange">
                    <a href="{{ path('reset_request') }}">
                        {{ 'security.login.forgotten'|trans }}
                    </a>
                </li>
                {% if registerButton %}
                    <li data-block="#l-forget-password" class="bgm-green">
                        <a href="{{ path(registerButton) }}">
                            {{ 'security.login.register'|trans }}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </form>
    </div>
</div>
{% endblock %}