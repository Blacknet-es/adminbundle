
{% if titleLogo is defined and titleLogo %}
    <a href="{{ path('admin') }}" class="top-bar-logo">
        <img src="{{ titleLogo }}" alt="{{ app_name }}"/>
    </a>
{% endif %}


{% if hideMenu is not defined or not hideMenu %}
    <div class="navigation-trigger" data-ma-action="aside-open" data-ma-target=".sidebar">
        <div class="navigation-trigger__inner">
            <i class="navigation-trigger__line"></i>
            <i class="navigation-trigger__line"></i>
            <i class="navigation-trigger__line"></i>
        </div>
    </div>
{% endif %}
{% if titleLogo is not defined or not titleLogo %}
    <div class="header__logo hidden-sm-down">
        <h1>
        <a href="{{ path('admin') }}">{{ app_name|default('Admin')|trans }} {% if title is defined and (hideTitle is not defined or not hideTitle) %}> {{ title|trans }}{% endif %}</a>
        </h1>
    </div>
{% endif %}

<!-- Top Search Content -->
