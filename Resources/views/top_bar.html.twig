    {# End Notifications #}
    {% if customMenu is defined %}
        {% include customMenu %}
    {% endif %}

    {# Filtros #}
    {% if useSideBar is defined and useSideBar %}
    <li data-ma-action="aside-open" data-ma-target="#rightbar">
        <a href=""><i class="zmdi {% if sideBarIcon is defined %}{{ sideBarIcon }}{% else %}zmdi-search{% endif %}"></i></a>
    </li>
