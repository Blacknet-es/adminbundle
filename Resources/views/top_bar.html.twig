                </div>
                <a class="lv-footer" href="">View All</a>
            </div>
        </div>
        #}
    </li>
    {% endif %}
    {# End Messages #}

    {# Notifications #}
    {% if (admin_notification_module is defined and admin_notification_module) %}
    <li class="dropdown">
        <a {% if admin_notification_module != true %}data-toggle="dropdown"{% endif %} href="{{ admin_notification_module }}">
            <i class="tm-icon zmdi zmdi-notifications"></i>
            <i class="tmn-counts notifications-badge"></i>
        </a>
    </li>

    {#
    <li class="dropdown">
        <a data-toggle="dropdown" href="">
