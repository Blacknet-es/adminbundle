{% import _self as menu %}

{% if app.user is defined and app.user %}
<div class="user">
    <div class="user__info" data-toggle="dropdown">
        <img class="user__img" src="/bundles/trendixadmin/img/profile-pics/{{ random(9) }}.jpg" alt="">
        <div>
            <div class="user__name">{{ app.user }}</div>
            <div class="user__email">{{ app.user.email }}</div>
        </div>
    </div>

    <div class="dropdown-menu">
        <!-- <a class="dropdown-item" href="#">View Profile</a> -->
        <a class="dropdown-item" href="{{ path('admin_logout') }}">{{ 'admin.logout'|trans }}</a>
    </div>
</div>
{% endif %}

<ul class="navigation">
    {% for option in principalMenu %}
        {{ menu.link(option, loop.index, principalMenu|length) }}
    {% endfor %}
</ul>

{% macro link(option, position, totalElements) %}
    {% import _self as linkMacro %}
    {% set path = 'javascript:void(0);' %}
    {% if option.route != null and option.route != '' %}
        {% set path = path(option.route, option.params) %}
    {% endif %}

    {% if position == 1 %}
        {% set class = 'first' %}
    {% endif %}

    {% if position == totalElements %}
        {% set class = 'last' %}
    {% endif %}

    {% if option.id == 'dashboard' %}
        {% set class = 'current first' %}
    {% endif %}

    {% spaceless %}
    <li {% if option.id != null %}id="{{ option.id }}"{% endif %} class="{% if class is defined %}{{ class }}{% endif %} {% if option.submenu|length > 0 %}navigation__sub{% endif %}">
        <a href="{{ path }}">
            {% if option.icon != null %}<i class="zmdi zmdi-{{ option.icon }}"></i>{% endif %}
            {{ option.label }}
        </a>
        {% if option.submenu|length > 0 %}
            {# submenu #}
            <ul>
                {% for suboption in option.submenu %}
                    {{ linkMacro.link(suboption, loop.index, option.submenu|length) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
    {% endspaceless %}
{% endmacro %}