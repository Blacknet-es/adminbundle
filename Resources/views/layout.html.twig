{% import 'TrendixAdminBundle::functions.html.twig' as functions %}

<!DOCTYPE html>
<!--[if IE 9 ]><html class="ie9"><![endif]-->
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name|trans }}{% endblock %}</title>

    <!-- CSS -->
    {% block css %}
        <!-- Vendor styles -->
        <link rel="stylesheet" href="/bundles/trendixadmin/vendors/bower_components/material-design-iconic-font/dist/css/material-design-iconic-font.min.css">
        <link rel="stylesheet" href="/bundles/trendixadmin/vendors/bower_components/animate.css/animate.min.css">
        <link rel="stylesheet" href="/bundles/trendixadmin/vendors/bower_components/jquery.scrollbar/jquery.scrollbar.css">
        <link rel="stylesheet" href="/bundles/trendixadmin/vendors/bower_components/fullcalendar/dist/fullcalendar.min.css">
        <link rel="stylesheet" href="{{ asset('/bundles/trendixadmin/css/imageWidget.css' ) }}">

        <!-- APP STYLES -->
        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="/bundles/trendixadmin/css/base.css">

        <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet" />
        <link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.9/summernote.css" rel="stylesheet">
    {% endblock %}

    <script src="{{ asset('/js/header.js') }}"></script>

    <script
            src="https://code.jquery.com/ui/1.12.0-rc.2/jquery-ui.min.js"
            integrity="sha256-55Jz3pBCF8z9jBO1qQ7cIf0L+neuPTD1u7Ytzrp2dqo="
            crossorigin="anonymous"></script>
</head>
<body class="{% block body_class %}{% endblock %}" data-ma-theme="{{ admin_theme|default("green") }}">

{% block body %}
<header class="header">
    {% include 'TrendixAdminBundle::top_bar.html.twig' %}
</header>

<aside id="sidebar" class="sidebar sidebar--hidden">
    {% if app.user is defined and app.user %}
        {% include 'TrendixAdminBundle::sidebarMenu.html.twig' %}
    {% endif %}
</aside>

{% if useSideBar is defined and useSideBar %}
    <aside id="rightbar" class="sidebar c-overflow">
        {% block sidebar_content %}
            {% if sideBarTemplate is defined and sideBarTemplate %}
                {% include sideBarTemplate %}
            {% else %}
                {% include 'TrendixAdminBundle::right_sidebar.html.twig' %}
            {% endif %}
        {% endblock %}
    </aside>
{% endif %}

<section id="main" class="content content--full">

    <div class="{% spaceless %}
        {# Boque que determina la clase del content #}
        {% block content_class %}
        {% if content_class is defined %}{{ content_class }}{% endif %}
        {% endblock %}
    {% endspaceless %}">
    {% block content %}{% endblock %}
    </div>

    <section id="actionButtons">
        {% block actionButtons %}{% endblock %}
    </section>
</section>

<footer id="footer" class="footer hidden-xs-down">
    {% include 'TrendixAdminBundle::footer.html.twig' %}
</footer>

{% include 'TrendixAdminBundle::genericModals.html.twig' %}
{% endblock %}

<!-- Page Loader -->
<div class="page-loader">
    <div class="page-loader__spinner">
        <svg viewBox="25 25 50 50">
            <circle cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10"></circle>
        </svg>
    </div>
</div>

<!-- Older IE warning message -->
<!--[if lt IE 9]>
<div class="ie-warning">
    <h1 class="c-white">Warning!!</h1>
    <p>You are using an outdated version of Internet Explorer, please upgrade <br/>to any of the following web browsers to access this website.</p>
    <div class="iew-container">
        <ul class="iew-download">
            <li>
                <a href="http://www.google.com/chrome/">
                    <img src="img/browsers/chrome.png" alt="">
                    <div>Chrome</div>
                </a>
            </li>
            <li>
                <a href="https://www.mozilla.org/en-US/firefox/new/">
                    <img src="img/browsers/firefox.png" alt="">
                    <div>Firefox</div>
                </a>
            </li>
            <li>
                <a href="http://www.opera.com">
                    <img src="img/browsers/opera.png" alt="">
                    <div>Opera</div>
                </a>
            </li>
            <li>
                <a href="https://www.apple.com/safari/">
                    <img src="img/browsers/safari.png" alt="">
                    <div>Safari</div>
                </a>
            </li>
            <li>
                <a href="http://windows.microsoft.com/en-us/internet-explorer/download-ie">
                    <img src="img/browsers/ie.png" alt="">
                    <div>IE (New)</div>
                </a>
            </li>
        </ul>
    </div>
    <p>Sorry for the inconvenience!</p>
</div>
<![endif]-->


{% block javascripts %}

    <!-- ../vendors -->
    {#
    <script src="/bundles/trendixadmin/vendors/bower_components/jquery/dist/jquery.min.js"></script>
    #}
    <script src="/bundles/trendixadmin/vendors/bower_components/popper.js/dist/umd/popper.min.js"></script>

    <script src="/bundles/trendixadmin/vendors/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/jquery.scrollbar/jquery.scrollbar.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/jquery-scrollLock/jquery-scrollLock.min.js"></script>

    <script src="/bundles/trendixadmin/vendors/bower_components/Flot/jquery.flot.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/Flot/jquery.flot.resize.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/flot.curvedlines/curvedLines.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/jqvmap/dist/jquery.vmap.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/jqvmap/dist/maps/jquery.vmap.world.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/jquery.easy-pie-chart/dist/jquery.easypiechart.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/salvattore/dist/salvattore.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/jquery.sparkline/jquery.sparkline.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/moment/min/moment.min.js"></script>
    <script src="/bundles/trendixadmin/vendors/bower_components/fullcalendar/dist/fullcalendar.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/summernote/0.8.9/summernote.js"></script>


    <!-- App functions and actions -->
    <script src="/bundles/trendixadmin/js/app.min.js"></script>


    <script src="{{ asset('/bundles/fosjsrouting/js/router.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', {"callback": "fos.Router.setData"}) }}"></script>
    <script src="//code.highcharts.com/4.2.2/highcharts.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
    <script type="text/javascript">
        $('select').select2();
        $('.html-editor').summernote();
    </script>

    {% if (admin_notification_module is defined and admin_notification_module) %}
        <script src="{{ asset('/bundles/trendixnotifications/notifications.js') }}"></script>
    {% endif %}
    <script src="{{ asset('/js/footer.js') }}"></script>


{% endblock %}
{% include "TrendixAdminBundle:forms:crop_image_modal.html.twig" %}

</body>
</html>