{% block javascripts %}
    {% javascripts
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/flot/jquery.flot.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/flot/jquery.flot.resize.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/flot.curvedlines/curvedLines.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/sparklines/jquery.sparkline.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/jquery.easy-pie-chart/dist/jquery.easypiechart.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/moment/min/moment.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/fullcalendar/dist/fullcalendar.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/simpleWeather/jquery.simpleWeather.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/Waves/dist/waves.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bootstrap-growl/bootstrap-growl.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/bootstrap-sweetalert/lib/sweet-alert.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/js/flot-charts/curved-line-chart.js'
    '@TrendixAdminBundle/Resources/public/material_admin/js/flot-charts/line-chart.js'
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/summernote/dist/summernote-updated.min.js'
    '@TrendixAdminBundle/Resources/public/material_admin/js/charts.js'
    '@TrendixAdminBundle/Resources/public/material_admin/js/functions.js'
    '@TrendixAdminBundle/Resources/public/material_admin/js/demo.js'
    '@TrendixAdminBundle/Resources/public/pickadate/lib/picker.js'
    '@TrendixAdminBundle/Resources/public/pickadate/lib/picker.date.js'
    '@TrendixAdminBundle/Resources/public/js/datepicker.js'
    '@TrendixAdminBundle/Resources/public/js/jscolor.min.js'
    '@TrendixAdminBundle/Resources/public/js/image_uploader.js'
    '@TrendixAdminBundle/Resources/public/js/conditional_fields.js'
    '@TrendixAdminBundle/Resources/public/js/actions.js'
    '@TrendixAdminBundle/Resources/public/jcrop/js/jquery.color.js'
    '@TrendixAdminBundle/Resources/public/jcrop/js/jquery.fileupload.js'
    '@TrendixAdminBundle/Resources/public/jcrop/js/jquery.Jcrop.min.js'
    '@TrendixAdminBundle/Resources/public/jcrop/js/imageWidget.js'
    %}
    <script src="{{ asset_url }}"></script>
    {% endjavascripts %}
    {% javascripts
    '@TrendixAdminBundle/Resources/public/material_admin/vendors/bower_components/jquery-placeholder/jquery.placeholder.min.js'
    %}
<!--[if IE 9 ]><script src="{{ asset_url }}"></script><![endif]-->

    {% endjavascripts %}
    <script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', {"callback": "fos.Router.setData"}) }}"></script>

    {% for var in _context %}
        {{ functions.appendJavascript(var) }}
    {% endfor %}
{% endblock %}
</body>
</html>