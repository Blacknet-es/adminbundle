{% extends 'TrendixAdminBundle::layout.html.twig' %}

{% import 'TrendixAdminBundle::btnMacros.html.twig' as buttons %}


{% block content %}
    {% include 'TrendixAdminBundle:Lista:lista.html.twig' %}
{% endblock %}

{% block actionButtons %}
    {% if lista.primaryAction is not null %}
        {% if lista.primaryAction.icon is defined %}
            {% set icon = lista.primaryAction.icon %}
        {% else %}
            {% set icon = 'plus' %}
        {% endif %}

        {% if lista.primaryAction != null %}
            {% set actionButtonColor = 'green' %}
            {% if settings is defined and settings['primary_color'] is defined %}
                {% set actionButtonColor = 'primary' %}
            {% endif %}
            {{ buttons.actionButton(lista.primaryAction.url, icon, actionButtonColor, lista.primaryAction.text)  }}
        {% endif %}
    {% endif %}
{% endblock %}
