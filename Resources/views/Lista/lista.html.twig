<div class="card lista-card">
    {% if lista.downloadable %}
        <form class="hidden list-download" method="post" id="list-download" action="{{ url('download_list') }}">
            <input type="hidden" name="class" value="{{ lista.listClass }}">
            <input type="hidden" name="call" value="{{ lista.listCall }}">
            <input type="hidden" name="title" value="{{ title }}">
        </form>
    {% endif %}
    <div class="card-body">
        <h4 class="card-title">{{ title|trans }}</h4>
        <div id="data-table-basic-header" class="bootgrid-header container-fluid">
            <div class="row">
                <div class="col-sm-12 actionBar">
                    {% if hideSearch is not defined or not hideSearch %}
                        <div class="search form-group pull-left">
                            <div class="input-group">
                                <span class="zmdi icon input-group-addon glyphicon-search"></span>
                                <input class="search-field form-control" placeholder="{% if lista.strictSearch %}{{ 'list.strict_search'|trans }}{% else %}{{ 'list.search'|trans }}{% endif %}"
                                       type="text" value="{{ lista.search }}">
                            </div>
                        </div>
                    {% endif %}
                    <div class="actions btn-group pull-left">
                        <button type="button" class="btn btn-light page-size-selector
                                {% if lista.maxResults == 10 %}disabled-button" disabled="disabled{% endif %}"
                                data-value="10">10</button>
                        <button type="button" class="btn btn-light page-size-selector
                                {% if lista.maxResults == 25 %}disabled-button" disabled="disabled{% endif %}"
                                data-value="25">25</button>
                        <button type="button" class="btn btn-light page-size-selector
                                {% if lista.maxResults == 50 %}disabled-button" disabled="disabled{% endif %}"
                                data-value="50">50</span>
                        </button>
                    </div>
                    <div class="actions pull-right">
                        {% if lista.downloadable %}
                            <a href="#" class="download-file" title="{{ 'admin.excel_download'|trans }}" >
                                <i class="zmdi zmdi-download"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% if lista.data is not empty %}
            <div class="table-responsive">
                <table id="data-table-selection" class="table table-striped table-vmiddle bootgrid-table" aria-busy="false">
                    <thead>
                    <tr>
                        {% if (lista.bulkActions | length) > 0 %}
                            <th class="text-left" style="">
                                <input type="checkbox" id="check-all">
                            </th>
                        {% endif %}
                        {% for field, label in lista.labels %}
                            <th data-column-id="id" class="text-left" style="">
                                <a href="javascript:void(0);" class="column-header-anchor sortable" data-value="{{ field }}">
                                    <span class="text">{{ label|trans }}</span>
                                </a>
                                {% if field == lista.orderColumn %}
                                    <span class="zmdi
                                    {% if lista.orderDirection %}
                                        zmdi-caret-down
                                    {% else %}
                                        zmdi-caret-up
                                    {% endif %}
                                    "></span>
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if row.actions is defined and row.actions|length > 0 %}
                            <th data-column-id="id" class="text-left" style="">
                                <a href="javascript:void(0);" class="column-header-anchor">
                                    <span class="text">{{ 'admin.actions'|trans }}</span><span class="zmdi icon"></span>
                                </a>
                            </th>
                        {% endif %}
                    </tr>
                    </thead>

                    <tbody>
                    {% for index, row in lista.data %}
                        {% if row.original_id is defined %}
                            {% set rowId = row.original_id %}
                        {% elseif row.id is defined %} {# Allows overriding the ID with a JoinType #}
                            {% set rowId = row.id %}
                        {% else %}
                            {% set rowId = loop.index %}
                        {% endif %}
                        <tr data-row-id="{{ rowId }}" class="" aria-selected="false">
                            {% if (lista.bulkActions | length) > 0 %}
                                <td class="text-left bulk-check"><input type="checkbox" class="checkbox bulk-checkbox" value="{{ rowId }}"/></td>
                            {% endif %}
                            {% for key, field in row if key != 'actions' and key != 'original_id' %}
                                <td class="text-left" data-col="{{ key }}" style="">{{ field|raw }}</td>
                            {% endfor %}
                            {% if row.actions is defined and row.actions|length > 0 %}
                                <td class="text-left actions" >
                                    {% for action in row.actions %}
                                        {% if action.advanced %}
                                            {% set viewData = action.viewData | merge({'id': rowId, 'data': row }) %}
                                            {% include action.view with viewData only %}
                                        {% else %}
                                            {% if action.action == 'delete' %}
                                            <a href="javascript:void(0);" data-ajax-action="{{ action.url }}" data-confirm="true" data-title="{{ 'admin.remove_element'|trans }}" data-message="{{ 'list.confirm_remove'|trans }}">
                                                <i class="zmdi zmdi-{{ action.icon }}"></i>
                                            </a>
                                            {% else %}
                                            <a href="{{ action.url }}" data-row-id="{{ rowId }}"
                                                {% if action.text %}
                                                    data-toggle="admin-tooltip" title="{{ action.text|trans }}"
                                                {% endif %}
                                                    >
                                                <i class="zmdi zmdi-{{ action.icon }}"></i>
                                            </a>
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}

                                    {#
                                    <a href="javascript:void(0);" data-row-id="{{ key }}">
                                        <i class="zmdi zmdi-delete"></i>
                                    </a>
                                    #}

                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </table>

                <div id="data-table-command-footer" class="bootgrid-footer container-fluid">
                    <div class="row">
                        {% if (lista.bulkActions | length) > 0 %}
                            <div class="col-sm-3">
                                <div class="form-group pull-left bulk-actions-select">
                                    <div class="input-group">
                                        <label for="list-group-actions">
                                            Acciones de grupo
                                        </label>
                                        <select id="list-group-actions" class="list-group-actions" required>
                                            {% for action in lista.bulkActions %}
                                                <option value="{% if action.advanced %}advanced:{{ action.action }}{% else %}{{ action.url }}{% endif %}">{{ action.text }}</option>
                                            {% endfor %}
                                        </select>
                                        <a class="btn btn-primary" href="#" data-action="useBulkAction" data-target=".bulk-checkbox">Enviar</a>
                                        {% for action in lista.bulkActions %}
                                            {% if action.advanced %}
                                                {% include 'TrendixAdminBundle:Lista:bulkModal.html.twig' with {action: action.action, title: action.text, view: action.view, viewData: action.viewData } only %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        <div class="{% if (lista.bulkActions | length) > 0 %}col-sm-6{% else %}col-sm-6{% endif %}">
                            {% if (lista.totalPage > 1) %}
                                <ul class="pagination">
                                    {% if lista.currentPage > 1 %}
                                        <li class="page-item pagination-first">
                                            <a data-page="1" class="page-link"></a>
                                        </li>
                                        <li class="page-item pagination-prev">
                                            <a data-page="{{ lista.currentPage - 1 }}" class="page-link"></a>
                                        </li>
                                        {% set first = max(1, lista.currentPage-5) %}
                                        {% for p in first..lista.currentPage - 1 %}
                                            <li class="page-{{ p }} page-item">
                                                <a data-page="{{ p }}" class="page-link">{{ p }}</a>
                                            </li>
                                        {% endfor %}
                                    {% endif %}

                                    <li class="page-{{ lista.currentPage }} page-item active">
                                        <a data-page="{{ lista.currentPage }}" class="page-link">{{ lista.currentPage }}</a>
                                    </li>

                                    {% if lista.currentPage < lista.totalPage %}
                                        {% set last = min(lista.totalPage, lista.currentPage+5) %}
                                        {% for p in lista.currentPage + 1..last %}
                                            <li class="page-{{ p }} page-item">
                                                <a data-page="{{ p }}" class="page-link">{{ p }}</a>
                                            </li>
                                        {% endfor %}
                                        <li class="page-item pagination-next">
                                            <a data-page="{{ lista.currentPage + 1}}" class="page-link"></a>
                                        </li>
                                        <li class="page-item pagination-last">
                                            <a data-page="{{ lista.totalPage }}" class="page-link"></a>
                                        </li>
                                    {% endif %}
                                </ul>
                            {% endif %}
                        </div>

                        <div class="{% if (lista.bulkActions | length) > 0 %}col-sm-3{% else %}col-sm-6{% endif %} infoBar">
                            <div class="infos">
                                {{ 'list.page'|trans({'%current%': lista.currentPage, '%total%': lista.totalPage}) }}
                            </div>
                        </div>
                    </div>

                    <form id="listaForm">
                        <input type="hidden" class="pag" name="pag" value="{{ lista.currentPage }}" />
                        <input type="hidden" class="search" name="search" value="{{ lista.search }}" />
                        <input type="hidden" class="max" name="max" value="{{ lista.maxResults }}" />
                        <input type="hidden" class="order_column" name="order_column" value="{{ lista.orderColumn }}" />
                        <input type="hidden" class="order_direction" name="order_direction" value="{{ lista.orderDirection }}" />
                        <input type="hidden" class="update_field" name="update_field" value="" />
                    </form>
                </div>
            </div>
        {% else %}
            <div class="card-body card-padding">
                {{ 'admin.no_elements'|trans }}
            </div>
        {% endif %}
    </div>
</div>
